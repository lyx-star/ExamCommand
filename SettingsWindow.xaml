<Window x:Class="ExamCommand.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试指令系统 - 设置"
        Width="580" Height="720"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="{StaticResource MiSans}"
        Foreground="#000000"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- 设置页文字一律黑色（含 Label/GroupBox 模板内文本） -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#000000" />
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#000000" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="#000000" />
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="CaretBrush" Value="#000000" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Foreground" Value="#000000" />
                    <Setter Property="CaretBrush" Value="#000000" />
                    <Setter Property="Background" Value="White" />
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Margin="0"
                                               MinWidth="120"
                                               Background="White"
                                               Foreground="#000000"
                                               CaretBrush="#000000"
                                               BorderThickness="1"
                                               BorderBrush="#C8C8C8"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="32"
                                    Focusable="False"
                                    Background="White"
                                    BorderBrush="#C8C8C8"
                                    BorderThickness="0,1,1,1">
                                <Path Data="M0,0 L8,8 L16,0 Z" Fill="#000000"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   StaysOpen="False">
                                <Calendar x:Name="PART_Calendar"
                                          Background="White"
                                          Foreground="#000000"
                                          BorderBrush="#C8C8C8" />
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MiSans}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#C8C8C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0084D0" />
            <Setter Property="BorderBrush" Value="#0084D0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0070B0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005F96" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24,32,16">
            <StackPanel>
                <TextBlock Text="考试指令系统 · 参数设置"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="#000000"
                           Margin="0,0,0,20" />

                <Label Content="首行标题" />
                <TextBox x:Name="TitleBox" Text="" Margin="0,0,0,12" />

                <Label Content="考试科目" />
                <TextBox x:Name="SubjectBox" Text="" Margin="0,0,0,12" />

                <GroupBox Header="开考时间"
                          Foreground="#000000"
                          FontFamily="{StaticResource MiSans}" FontSize="13"
                          BorderBrush="#C8C8C8" Margin="0,0,0,12" Padding="10,8">
                    <StackPanel>
                        <Label Content="日期" Foreground="#000000" />
                        <DatePicker x:Name="StartDate" Margin="0,0,0,10" Foreground="#000000" />

                        <Label Content="时间（可下拉选择，也可直接键入数字）" Foreground="#000000" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StartHour" Width="84" Margin="0,0,6,0"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      ToolTip="时 0–23，可下拉或键入" />
                            <TextBlock Text="时" Margin="4,0,14,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="StartMinute" Width="84" Margin="0,0,6,0"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      ToolTip="分 0–59，可下拉或键入" />
                            <TextBlock Text="分" Margin="4,0,14,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="StartSecond" Width="84" Margin="0,0,6,0"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      ToolTip="秒 0–59，可下拉或键入" />
                            <TextBlock Text="秒" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <Label Content="考试持续时长（分钟）" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="DurationBox" Width="120" Text="75" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="45" Width="56" Margin="0,0,6,0" Click="Duration45_Click" />
                        <Button Content="75" Width="56" Margin="0,0,6,0" Click="Duration75_Click" />
                        <Button Content="90" Width="56" Margin="0,0,6,0" Click="Duration90_Click" />
                        <Button Content="120" Width="56" Click="Duration120_Click" />
                    </StackPanel>
                </StackPanel>

                <Label Content="底部落款 · 左" />
                <TextBox x:Name="FooterLeftBox" Text="" Margin="0,0,0,12" />

                <Label Content="底部落款 · 右" />
                <TextBox x:Name="FooterRightBox" Text="" Margin="0,0,0,12" />

                <TextBlock x:Name="HintText"
                           Text="点击「开始考试」后进入大屏界面；按 ESC 可退出全屏，Alt+F4 退出程序。"
                           FontSize="12" Foreground="#000000" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定操作条：始终可见，不被内容遮挡 -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="32,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="AboutButton"
                        Content="关于"
                        Width="72" Height="48"
                        FontSize="15"
                        VerticalAlignment="Stretch"
                        Click="About_Click" />
                <Button Grid.Column="1"
                        x:Name="StartButton"
                        Content="开始考试"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="Start_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
