<Window x:Class="ExamCommand.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="400" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="{StaticResource MiSans}"
        Foreground="#000000">

    <StackPanel Margin="32,28" VerticalAlignment="Center">

        <!-- 圆形头像（约 85%：112→95） -->
        <Ellipse Width="95" Height="95" HorizontalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush ImageSource="/ExamCommand;component/Resources/avatar.jpg"
                            Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <!-- 应用名称与版本 -->
        <TextBlock Text="考试指令系统"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="#000000"
                   HorizontalAlignment="Center"
                   Margin="0,18,0,4" />
        <TextBlock Text="v1.0.0"
                   FontSize="14"
                   Foreground="#666666"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />

        <!-- 作者 -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="作者：" FontSize="15" Foreground="#000000" VerticalAlignment="Center" />
                <TextBlock Text="lyx" FontSize="15" FontWeight="SemiBold"
                           Foreground="#000000" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 可点击 GitHub 主页 -->
            <TextBlock FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Hyperlink x:Name="GitHubLink"
                           NavigateUri="https://github.com/lyx-star"
                           RequestNavigate="GitHubLink_RequestNavigate"
                           Foreground="#0084D0"
                           TextDecorations="Underline">
                    https://github.com/lyx-star
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Content="关闭"
                Width="100" Height="34"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Click="Close_Click" />
    </StackPanel>
</Window>
