<Window x:Class="ExamCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="考试指令系统"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Normal"
        Width="1440" Height="810"
        MinWidth="960" MinHeight="540"
        ResizeMode="CanResizeWithGrip"
        Background="#0084D0"
        FontFamily="{StaticResource MiSansDemibold}"
        Foreground="#C0FFFF"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <!-- 固定设计分辨率 1920×1080，Viewbox 等比缩放 -->
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部标题 · 约 110%（72→79） -->
                <TextBlock Grid.Row="0"
                           x:Name="TitleText"
                           Text="考试指令系统"
                           FontSize="79"
                           FontWeight="Normal"
                           Foreground="#C0FFFF"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,28,0,16" />

                <!-- 考试信息区 · 约 110%（含底部分隔线） -->
                <StackPanel Grid.Row="1" Margin="120,0,120,0" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="考试科目：" FontSize="46" FontWeight="Normal" HorizontalAlignment="Left" />
                        <TextBlock x:Name="SubjectText" Text="科目 准备" FontSize="62" FontWeight="Normal" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="开考时间：" FontSize="40" FontWeight="Normal" HorizontalAlignment="Left" />
                        <TextBlock x:Name="StartTimeText" Text="—" FontSize="40" FontWeight="Normal" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="结束时间：" FontSize="40" FontWeight="Normal" HorizontalAlignment="Left" />
                        <TextBlock x:Name="EndTimeText" Text="—" FontSize="40" FontWeight="Normal" />
                    </StackPanel>
                    <!-- 信息区与系统时间之间的分隔线 -->
                    <Border Height="2" Background="#0069A8" Margin="0,10,0,0" />
                </StackPanel>

                <!-- 当前系统时间 + 下方横线 + 倒计时：紧凑排列，上下留白减小 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 时钟上方仅保留较小留白 -->
                    <Border Grid.Row="0" Height="36" Background="Transparent" />

                    <TextBlock Grid.Row="1"
                               x:Name="ClockText"
                               Text="00:00:00"
                               FontSize="280"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource MiSans}"
                               TextAlignment="Center"
                               Margin="0,0,0,0" />

                    <!-- 系统时间下方唯一一条横线（贴近时钟） -->
                    <Border Grid.Row="2"
                            Height="2"
                            Background="#0069A8"
                            Margin="0,10,0,0" />

                    <!-- 倒计时 / 结束提示：紧贴横线，居左（与考试科目对齐） -->
                    <StackPanel Grid.Row="3" Margin="120,8,80,0">
                        <TextBlock x:Name="StatusText"
                                   Text="—"
                                   FontSize="61"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- 剩余高度落在倒计时下方，避免时钟上下大段空白 -->
                    <Border Grid.Row="4" Background="Transparent" />
                </Grid>

                <!-- 底部落款 · 约 110% -->
                <Grid Grid.Row="3" Margin="100,14,100,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="FooterLeftText"
                               Text=""
                               FontSize="37" FontWeight="Normal"
                               TextAlignment="Left" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" x:Name="FooterRightText"
                               Text=""
                               FontSize="37" FontWeight="Normal"
                               TextAlignment="Right" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Viewbox>

        <!-- 角落纯图标按钮（在 Viewbox 外，不随界面缩放） -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12"
                    ZIndex="10">
            <StackPanel.Resources>
                <Style x:Key="CornerButton" TargetType="Button">
                    <Setter Property="Background" Value="#C0FFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Opacity="0.9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <!-- 返回设置：← -->
            <Button x:Name="BackButton"
                    Margin="0,0,6,0"
                    Style="{StaticResource CornerButton}"
                    Click="Back_Click"
                    ToolTip="返回参数设置界面">
                <Path Data="M14.5,5 L8,10 L14.5,15 M8,10 H18"
                      Stroke="#0084D0" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- 全屏 / 退出全屏：四角展开图标 -->
            <Button x:Name="FullscreenButton"
                    Style="{StaticResource CornerButton}"
                    Click="Fullscreen_Click"
                    ToolTip="切换全屏 / 窗口化（Esc 同样可切换）">
                <Path x:Name="FullscreenIcon"
                      Data="M2,6 V2 H6 M14,2 H18 V6 M18,14 V18 H14 M6,18 H2 V14"
                      Stroke="#0084D0" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
